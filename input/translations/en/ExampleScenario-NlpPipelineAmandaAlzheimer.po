# English translations for ExampleScenario/NlpPipelineAmandaAlzheimer.
# Generated from the IG Publisher's own template (translations/en/po/) so every
# msgid matches the resource verbatim. Identity strings (name, publisher, contact
# name, the jurisdiction display) carry no translation on purpose — a unit with an
# empty msgstr would produce an invalid translation extension.

# ExampleScenario.purpose
#: ExampleScenario.purpose
msgid "Zeigt, wie das Dokument-Profil und die Extension MII_EX_Dokument_NLP_Processing_Status die Ergebnisdokumente einer NLP-Verarbeitungskette und ihre Beziehungen (relatesTo: transforms, appends) abbilden."
msgstr "Shows how the Dokument profile and the MII_EX_Dokument_NLP_Processing_Status extension represent the result documents of an NLP processing chain and their relationships (relatesTo: transforms, appends)."

# ExampleScenario.actor.name
#: ExampleScenario.actor.name
msgid "Dokumentenquelle"
msgstr "Document source"

# ExampleScenario.actor.description
#: ExampleScenario.actor.description
msgid "System oder Bestand, aus dem die zu verarbeitenden Dokumente stammen — im Beispiel der synthetische Korpus GraSCCo (Graz Synthetic Clinical text Corpus, DOI 10.5281/zenodo.6539130), aus dem der Entlassbrief `Amanda_Alzheimer.docx` stammt; in der Praxis etwa ein Dokumentenarchiv oder Dokumentenmanagementsystem, ein Krankenhausinformationssystem, eine Forschungsdatenbank oder ein Dateispeicher."
msgstr "System or holding the documents to be processed come from — in this example the synthetic corpus GraSCCo (Graz Synthetic Clinical text Corpus, DOI 10.5281/zenodo.6539130), the source of the discharge letter `Amanda_Alzheimer.docx`; in practice a document archive or document management system, a hospital information system, a research database or a file store."

# ExampleScenario.actor.name
#: ExampleScenario.actor.name
msgid "NLP-Pipeline / Annotationsframework"
msgstr "NLP pipeline / annotation framework"

# ExampleScenario.actor.description
#: ExampleScenario.actor.description
msgid "Werkzeugkette, die die Verarbeitungsschritte teil- oder vollautomatisch ausführt — Klartext-Extraktion, automatische Vorannotation identifizierender Angaben, Ersetzung durch typkonforme Surrogate, semantische Annotation (z. B. Annotationsplattform INCEpTION mit vorgeschalteter NLP-Komponente, vgl. die De-Identifikations-Pipeline des GeMTeX-Projekts) — und für jedes Ergebnisdokument eine Dokumentreferenz erzeugt."
msgstr "Tool chain that carries out the processing steps semi- or fully automatically — plain-text extraction, automatic pre-annotation of identifying items, replacement by type-conformant surrogates, semantic annotation (for example the INCEpTION annotation platform with an upstream NLP component, compare the de-identification pipeline of the GeMTeX project) — and creates a document reference for every result document."

# ExampleScenario.actor.name
#: ExampleScenario.actor.name
msgid "Annotierende"
msgstr "Annotators"

# ExampleScenario.actor.description
#: ExampleScenario.actor.description
msgid "Fachpersonen, die die automatische Vorannotation prüfen und korrigieren (Kuratierung der De-Identifikation) und die semantische Annotation im Annotationsframework vornehmen."
msgstr "Specialists who review and correct the automatic pre-annotation (curation of the de-identification) and carry out the semantic annotation in the annotation framework."

# ExampleScenario.actor.name
#: ExampleScenario.actor.name
msgid "Dokumentenrepository (FHIR)"
msgstr "Document repository (FHIR)"

# ExampleScenario.actor.description
#: ExampleScenario.actor.description
msgid "FHIR-Server, der die Dokumentreferenzen aller Verarbeitungsstufen mit ihren NLP-Verarbeitungsstatus und `relatesTo`-Verknüpfungen ablegt. Das Repository führt keine Transformation aus; es dokumentiert die Ergebnisse der Pipeline."
msgstr "FHIR server that stores the document references of every processing stage with their NLP processing status and `relatesTo` links. The repository performs no transformation; it documents the results of the pipeline."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Originaldokument (Amanda_Alzheimer.docx)"
msgstr "Original document (Amanda_Alzheimer.docx)"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Ausgangspunkt der Kette: `Amanda_Alzheimer.docx` (`application/vnd.openxmlformats-officedocument.wordprocessingml.document`, `attachment.creation` 2028-02-06). NLP-Verarbeitungsstatus `unprocessed`; kein `relatesTo`. Verweist auf die Patientin (`subject`) und den Einrichtungskontakt (`context.encounter`)."
msgstr "Starting point of the chain: `Amanda_Alzheimer.docx` (`application/vnd.openxmlformats-officedocument.wordprocessingml.document`, `attachment.creation` 2028-02-06). NLP processing status `unprocessed`; no `relatesTo`. References the patient (`subject`) and the facility contact (`context.encounter`)."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Klartext-Dokument (Amanda_Alzheimer.txt)"
msgstr "Plain-text document (Amanda_Alzheimer.txt)"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Ergebnis der Klartext-Extraktion: `Amanda_Alzheimer.txt` (`text/plain`, `attachment.creation` 2028-02-06). Status `preprocessed`, `format-change`; `relatesTo.transforms` → Originaldokument. Verweist weiterhin auf die Patientin und den Einrichtungskontakt."
msgstr "Result of the plain-text extraction: `Amanda_Alzheimer.txt` (`text/plain`, `attachment.creation` 2028-02-06). Status `preprocessed`, `format-change`; `relatesTo.transforms` → original document. Still references the patient and the facility contact."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "De-identifiziertes Dokument (De-ID.txt)"
msgstr "De-identified document (De-ID.txt)"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Ergebnis der De-Identifikation: `De-ID.txt` (`text/plain`). Status `preprocessed`, `format-change`, `surrogated`; `relatesTo.transforms` → Klartext-Dokument. Ohne `subject` und ohne `context.encounter` — die identifizierenden Angaben sind durch Surrogate ersetzt, das Ergebnisdokument ist keinem Patientenkontext mehr zugeordnet."
msgstr "Result of the de-identification: `De-ID.txt` (`text/plain`). Status `preprocessed`, `format-change`, `surrogated`; `relatesTo.transforms` → plain-text document. Without `subject` and without `context.encounter` — the identifying items have been replaced by surrogates, so the result document is no longer tied to a patient context."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Annotiertes Dokument (Annotat.zip)"
msgstr "Annotated document (Annotat.zip)"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Ergebnis der semantischen Annotation: `Annotat.zip` (`application/zip`). Status `annotated`, `semantic`, `surrogated`, `preprocessed`, `format-change`; `relatesTo.appends` → de-identifiziertes Dokument, da die Annotationen das Dokument ergänzen und nicht ersetzen. Ebenfalls ohne `subject` und `context.encounter`."
msgstr "Result of the semantic annotation: `Annotat.zip` (`application/zip`). Status `annotated`, `semantic`, `surrogated`, `preprocessed`, `format-change`; `relatesTo.appends` → de-identified document, because the annotations supplement the document rather than replace it. Likewise without `subject` and `context.encounter`."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Patientin Amanda Alzheimer"
msgstr "Patient Amanda Alzheimer"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Synthetische Patientin; `subject` des Original- und des Klartext-Dokuments. Ab der De-Identifikation wird sie nicht mehr referenziert."
msgstr "Synthetic patient; `subject` of the original and the plain-text document. From the de-identification onwards she is no longer referenced."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Einrichtungskontakt"
msgstr "Facility contact"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "`context.encounter` des Original- und des Klartext-Dokuments und oberster Kontakt der Kontakthierarchie (ohne `partOf`)."
msgstr "`context.encounter` of the original and the plain-text document, and the topmost contact of the contact hierarchy (no `partOf`)."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Abteilungskontakt"
msgstr "Department contact"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Mittlere Ebene der Kontakthierarchie (`partOf` → Einrichtungskontakt); von keiner Dokumentreferenz unmittelbar referenziert."
msgstr "Middle level of the contact hierarchy (`partOf` → facility contact); not referenced directly by any document reference."

# ExampleScenario.instance.name
#: ExampleScenario.instance.name
msgid "Versorgungsstellenkontakt"
msgstr "Point-of-care contact"

# ExampleScenario.instance.description
#: ExampleScenario.instance.description
msgid "Unterste Ebene der Kontakthierarchie (`partOf` → Abteilungskontakt); von keiner Dokumentreferenz unmittelbar referenziert."
msgstr "Lowest level of the contact hierarchy (`partOf` → department contact); not referenced directly by any document reference."

# ExampleScenario.process.title
#: ExampleScenario.process.title
msgid "NLP-Verarbeitung eines Entlassbriefs"
msgstr "NLP processing of a discharge letter"

# ExampleScenario.process.description
#: ExampleScenario.process.description
msgid "Vier Verarbeitungsschritte der NLP-Pipeline (teil- oder vollautomatisch, mit Prüfung durch Annotierende); die FHIR-DocumentReference-Ressourcen dokumentieren nur die Ergebnisse dieser Schritte, kumulieren den NLP-Verarbeitungsstatus und verknüpfen die Ergebnisdokumente über `relatesTo`. Das Dokumentenrepository transformiert nichts — es speichert die Dokumentreferenzen."
msgstr "Four processing steps of the NLP pipeline (semi- or fully automatic, reviewed by annotators); the FHIR DocumentReference resources only document the results of these steps, accumulate the NLP processing status and link the result documents through `relatesTo`. The document repository transforms nothing — it stores the document references."

# ExampleScenario.process.preConditions
#: ExampleScenario.process.preConditions
msgid "Der Entlassbrief `Amanda_Alzheimer.docx` liegt in der Dokumentenquelle vor; Patientin und Einrichtungskontakt sind als FHIR-Ressourcen vorhanden."
msgstr "The discharge letter `Amanda_Alzheimer.docx` is present in the document source; the patient and the facility contact exist as FHIR resources."

# ExampleScenario.process.postConditions
#: ExampleScenario.process.postConditions
msgid "Vier Dokumentreferenzen (Original, Klartext, de-identifiziert, annotiert) mit `relatesTo`-Kette und NLP-Verarbeitungsstatus liegen im Repository; die Ergebnisdokumente selbst liegen als Anhang oder Verweis in der jeweiligen Dokumentreferenz."
msgstr "Four document references (original, plain text, de-identified, annotated) with their `relatesTo` chain and NLP processing status are held in the repository; the result documents themselves are carried as an attachment or a reference in the respective document reference."

