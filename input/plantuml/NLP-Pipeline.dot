@startdot "NLP-Pipeline"
digraph pipeline {
    splines=true
    node [
        fixedsize=true
        width=2
        fontname="sans-serif"
        fontsize=12
    ]
    edge [
        fontname="sans-serif"
        fontsize=9
        style=dotted
        color=black
        fontcolor=black
    ]

    subgraph steps {
        rank=same
        splines=line
        node [
            style="filled,rounded"
            shape=box
            fillcolor=lightyellow
        ]
        edge [
            style=solid
            color=default
            fontcolor=default
        ]

        s1 [label="Ingestion"]
        s2 [
            label="Preprocessing"
            style="dashed,rounded"
            color=grey
            fontcolor=grey
        ]
        s3 [label="De-Identification"]
        s4 [label="Annotation"]
        s1 -> s2 -> s3 -> s4
    }

    subgraph results {
        rank=same
        splines=curved
        node [
            style=filled
            shape=note
            fillcolor=lightgrey
            width=2
        ]
        edge [
            dir=back
            style=dashed
            headport=sw
            tailport=se
        ]

        r1 [label="Amanda_Alzheimer.txt"]
        r3 [label="De-ID.txt"]
        r4 [label="Annotat.zip"]

        r1 -> r3 [label="transforms"]
        r3 -> r4 [label="appends"]
    }

    s1 -> r1 [label="unprocessed (Lvl 1)", color=darkblue, fontcolor=darkblue]
    s3 -> r3 [xlabel="preprocessed (Lvl 1),\nformat-change (Lvl 2)", color=darkred, fontcolor=darkred]
    s3 -> r3 [label="surrogated (Lvl 1)", color=darkpurple, fontcolor=darkpurple]
    s4 -> r4 [label="annotated (Lvl 1),\nsemantic (Lvl 2)", color=darkgreen, fontcolor=darkgreen]
}
@enddot
