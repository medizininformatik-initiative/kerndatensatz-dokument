@startdot "NLP-Pipeline"
digraph pipeline {
    splines=true
    node [
        fixedsize=true
        width=2
        fontname="sans-serif"
        fontsize=12
    ]
    edge [
        fontname="sans-serif"
        fontsize=9
        style=dotted
        color=black
        fontcolor=black
    ]

    subgraph steps {
        rank=same
        splines=line
        node [
            style="filled,rounded"
            shape=box
            fillcolor=lightyellow
        ]
        edge [
            style=solid
            color=default
            fontcolor=default
        ]

        s1 [label="Ingestion"]
        s2 [label="Preprocessing"]
        s3 [label="De-Identification"]
        s4 [label="Annotation"]
        s1 -> s2 -> s3 -> s4
    }

    subgraph results {
        rank=same
        splines=curved
        node [
            style=filled
            shape=note
            fillcolor=lightgrey
            width=2
        ]
        r0 [label="Amanda_Alzheimer.docx"]
        r1 [label="Amanda_Alzheimer.txt"]
        r3 [label="De-ID.txt"]
        r4 [label="Annotat.zip"]

        // Invisible chain to pin the visual order r0 → r1 → r3 → r4
        r0 -> r1 -> r3 -> r4 [style=invis]

        // Visible relatesTo edges; constraint=false so they don't influence layout.
        // Direction follows FHIR DocumentReference.relatesTo (target = source of transformation).
        r1 -> r0 [label="transforms", style=dashed, constraint=false, headport=se, tailport=sw]
        r3 -> r1 [label="transforms", style=dashed, constraint=false, headport=se, tailport=sw]
        r4 -> r3 [label="appends",    style=dashed, constraint=false, headport=se, tailport=sw]
    }

    s1 -> r0 [label="unprocessed (Lvl 1)", color=darkblue, fontcolor=darkblue]
    s2 -> r1 [xlabel="[preprocessed (Lvl 1),\nformat-change (Lvl 2)]", color=darkred, fontcolor=darkred]
    s3 -> r3 [xlabel="[preprocessed (Lvl 1),\nformat-change (Lvl 2)]", color=darkred, fontcolor=darkred]
    s3 -> r3 [label="surrogated (Lvl 1)", color=darkpurple, fontcolor=darkpurple]
    s4 -> r4 [label="[annotated (Lvl 1), semantic (Lvl 2)],\nsurrogated (Lvl 1),\n[preprocessed (Lvl 1), format-change (Lvl 2)]", color=darkgreen, fontcolor=darkgreen]
}
@enddot
