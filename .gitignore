.DS_Store
Thumbs.db
fhirpkg.lock.json
validator_cli.jar

# --- IG Publisher / SUSHI build artifacts (regenerated on every build) ---
# The generated IG website. Never commit it; previews are published via CI.
/output/
# IG Publisher scratch space.
/temp/
/out/
# The IG template the publisher extracts into ./template at build time
# (ig.ini references ig-template-mii-kds by repository URL; the extracted
# copy is a build artifact).
/template/
# The IG Publisher jar itself — downloaded, version-pinned, never committed.
publisher.jar
# The IG Publisher's translation working directory at the repo ROOT (not
# input/translations!) — build scratch, never committed.
/translations/
# Everything under input-cache is transient EXCEPT the terminology cache:
# the committed txcache makes CI render the same ValueSet expansions the
# local build produced (the publisher consults the cache BEFORE the server),
# while the PACKAGE stays intensional (expansions never enter fsh-generated).
/input-cache/*
!/input-cache/txcache/
# NOTE: fsh-generated/ is deliberately COMMITTED (org CI convention; the MII
# reusable validation reads it), unlike the template default.

# --- Tooling ---
node_modules/

# --- OS / editor noise ---
*.log
# The migration run log and its per-step raw logs are EVIDENCE, committed
# with the branch (skill mii-ig-migration, run-log contract).
!migration-log/*.log
!migration-log/*.prev.log
